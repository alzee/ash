#!/bin/bash
#
# vim:ft=bash

# permanent?
conn="$(nmcli -t -f NAME connection show --active | head -1)"

# sudo nmcli con modify "$conn" +ipv4.routes "172.20.0.0/16 192.168.112.188"
sudo nmcli con modify "$conn" +ipv4.routes "$1 $2"
sudo nmcli con up "$conn"
#nmcli con modify "$conn" -ipv4.routes "$1 $2"

