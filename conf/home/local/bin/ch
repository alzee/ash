#!/bin/bash
#
# vim:ft=bash

dir=${1:-z}
use_proxy=${2:-1}
prefix=~/.chromium
# prefix=~/.config/google-chrome
chrome=chromium-browser
if ! which $chrome &> /dev/null; then
    chrome=google-chrome
fi

# $chrome --profile-directory=$profile

proxy_param="--proxy-server=socks5://s:1080"
if [ "$use_proxy" = 0 ]; then
    unset proxy_param
fi

$chrome --user-data-dir=$prefix/$dir $proxy_param 2> /dev/null &
