# params: $zone $record $content $type
update(){
    local url method content type
    url="https://api.cloudflare.com/client/v4/zones/$ZONE_ID/dns_records/$RECORD_ID"
    # method=GET
    method=PATCH

    curl -s -X $method $url \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type:application/json" \
        --data "{
            \"content\": \"$content\",
            \"name\": \"$RECORD_NAME\",
            \"proxied\": false,
            \"type\": \"A\",
            \"comment\": \"dns.sh: $(date)\",
            \"tags\": [],
            \"ttl\": 1
        }"
}
