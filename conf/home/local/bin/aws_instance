#!/bin/bash
# vim:ft=sh

idfile=~/.aws/instance_id

jq_aws_instance_ip(){
    # use xargs only for removing quotes
    jq '.Reservations[0].Instances[0].PublicIpAddress' | xargs
}

jq_aws_instance_id(){
    # use xargs only for removing quotes
    jq '.Reservations[0].Instances[0].InstanceId' | xargs
}

run(){
    local id ip is_spot spot_clause
    [ "$1" ] && is_spot=1
    if [ "$is_spot" ]; then
        spot_clause=(
            --instance-market-options
            '{"MarketType": "spot", "SpotOptions": { "MaxPrice": "0.003", "SpotInstanceType": "one-time", "InstanceInterruptionBehavior": "terminate"}}'
            )
    else
        spot_clause=
    fi
    id=$(aws ec2 run-instances --launch-template LaunchTemplateName=min "${spot_clause[@]}" | jq '.Instances[0].InstanceId' | xargs | tee $idfile)
    ip=$(aws ec2 describe-instances --instance-ids $id | jq_aws_instance_ip)
    addhost $ip aws
    # dns update $zone $record $ip
}

terminate(){
    local id
    # id=$(aws ec2 describe-instances | jq_aws_instance_id)
    id=$(< $idfile)
    aws ec2 terminate-instances --instance-ids $id
    sed -i '/^aws/d' ~/.ssh/known_hosts
}

case $1 in
    r|run)
        run "$2"
        ;;
    t|terminate)
        terminate
        ;;
esac
